[
   {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "maxItems": 5,
        "items": {
            "type": "object",   
            "properties": {
            "nom": { "type": "string", "minLength": 6},
            "nivel": {"type": "integer", "minimum": 1, "maximum": 50},
            "clases": {"type": "array", "items": {"type": "string"}}
        }
        },
       "required": ["nom", "nivel"]
    },
    "ejemplos",[
    [
        {
            "nom": "Aragorn",
            "nivel": 30,
            "clases": ["Guerrero", "Mago"]
        },
        {
            "nom":"Gandalf",
            "nivel": 45,
            "clases": ["Mago"]
        }
    ]
    ]
]